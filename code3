#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int count = 1, i;
    
    printf("Type a sentence: ");
    fgets(str, sizeof(str), stdin);
    
    for (i = 0; i < strlen(str); i++) {
        if (str[i] == ' ') {
            count++;
        }
    }
    
    printf("Total number of words: %d\n", count);
    return 0;
}

